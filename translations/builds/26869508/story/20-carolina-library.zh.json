  "LibrarySectionDescription": {
    "0": "书架上塞满各式各色的书。",
    "1": "各色破旧书脊，一直延伸到视线尽头。",
    "2": "不可计量的著作，列满书架。",
    "3": "书架挤满各种脆弱的书。",
    "4": "无数卷册，形制各异。",
    "5": "大片书海，一直铺进黑暗。"
  },
  "SharedLibraryLines": {
    "0": "内容完全无法辨认。",
    "1": "刚一抓起，书页便碎成潮湿粉尘。",
    "2": "看不出任何值得注意的内容。",
    "3": "光是目录就有",
    "4": "页。读完之前，你早就死了。",
    "5": "字迹糊得无影无踪。",
    "6": "它立刻在你手中散架。",
    "7": "书页粘成实心纸块。曾经写在这里的一切，都无法挽回。",
    "8": "其中曾有的知识，已永远失落。",
    "9": "没有对你有用或有趣的内容。",
    "10": "彻底毁坏。无法辨出任何意义。",
    "11": "还有多少？",
    "12": "会一直这样吗？",
    "13": "你会永远困在这里吗？",
    "14": "到底会不会结束？",
    "15": "它们不断冒出来……",
    "16": "无论拿走多少，总有新的在原处出现。",
    "17": "这里就没有任何有价值的东西吗？"
  },
